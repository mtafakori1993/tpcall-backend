HTTP_HOST=0.0.0.0
HTTP_PORT=9090

PUBLIC_BASE_URL=http://192.168.1.200:9090

DATABASE_URL=postgres://tpcall:tpcall_password@postgres:5432/tpcall?sslmode=disable

# Mandatory. Use a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_EXPIRATION=24h

RING_TIMEOUT=30s

LOG_LEVEL=info

# Comma-separated CORS origins ("*" for local development).
CORS_ORIGINS=*

# Optional comma-separated ICE server URLs, e.g. stun:stun.l.google.com:19302
ICE_SERVERS=

# Optional TURN relay (coturn with use-auth-secret). Clients get short-lived credentials
# from GET /api/v1/webrtc/config. TURN_SECRET is required when TURN_URLS is set.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SECRET=
# TURN_TTL=24h

# Directory containing SQL migrations (default ./migrations).
# MIGRATIONS_DIR=./migrations
